@model List<Warehouse_25DH110365.Models.Product>
@using Warehouse_25DH110365.Helpers

<table class="table table-bordered table-striped">
    <tr>
        <th>Mã</th>
        <th>Tên sản phẩm</th>
        <th>Danh mục</th>
        <th>Đơn giá</th>
        <th>Số lượng</th>
        <th>Tình trạng</th>
        <th></th>
    </tr>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.ProductID</td>
            <td>@p.ProductName</td>
            <td>@p.Category</td>
            <td>@p.Price.ToString("N0")</td>
            <td>@p.Quantity</td>
            <td>@StockHelper.GetStatus(p.Quantity)</td>
            <td>@Html.ActionLink("Sửa", "Edit", new { id = p.ProductID })</td>
        </tr>
    }
</table>