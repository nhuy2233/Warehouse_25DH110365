<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Warehouse_25DH110365</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body {
            padding: 0;
            margin: 0;
        }

        .wh-header {
            background: #1f4e79;
            color: #fff;
            padding: 15px 25px;
            font-size: 20px;
            font-weight: bold;
        }

        .wh-wrap {
            display: flex;
            min-height: 70vh;
        }

        .wh-menu {
            width: 230px;
            background: #f0f0f0;
            padding: 15px;
        }

            .wh-menu a {
                display: block;
                padding: 8px 10px;
                color: #1f4e79;
                text-decoration: none;
                border-bottom: 1px solid #ddd;
            }

                .wh-menu a:hover {
                    background: #dfe9f3;
                }

        .wh-main {
            flex: 1;
            padding: 20px 25px;
        }

        .wh-footer {
            background: #1f4e79;
            color: #fff;
            padding: 12px 25px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="wh-header">Họ tên: BuiNhutHuy – MSSV: 25DH110365</div>
    <div class="wh-wrap">
        <div class="wh-menu">
            <a href="@Url.Action("Index", "Home")">Trang chủ</a>
            <a href="@Url.Action("Index", "Products")">Câu 2: Danh sách / Sửa</a>
            <a href="@Url.Action("Search", "Products")">Câu 3: Tra cứu</a>
            <a href="@Url.Action("Stocktake", "Products")">Câu 4: Kiểm kê 1 SP</a>
            <a href="@Url.Action("Stocktake2", "Products")">Câu 5: Kiểm kê 2 SP</a>
            <a href="@Url.Action("Create", "Products")">Câu 6: Thêm sản phẩm</a>
            <a href="@Url.Action("Stats", "Products")">Câu 7: Thống kê</a>
        </div>
        <div class="wh-main">@RenderBody()</div>
    </div>
    <div class="wh-footer">Ngày sinh: 23/08/2007</div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>