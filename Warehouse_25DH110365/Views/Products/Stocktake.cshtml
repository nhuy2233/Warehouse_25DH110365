@{ ViewBag.Title = "Kiểm kê"; }

<h2>Cập nhật số lượng theo kiểm kê</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (ViewBag.Result != null)
{
    <div class="alert alert-info">@ViewBag.Result</div>
}

<form method="post" action="@Url.Action("Stocktake", "Products")" style="max-width:500px">
    <div class="form-group">
        <label>Sản phẩm</label>
        @Html.DropDownList("productId", (SelectList)ViewBag.ProductList, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Quantity thực tế</label>
        <input type="text" name="actualQty" class="form-control" value="@ViewBag.ActualQty" />
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    @Html.ActionLink("Xem danh sách", "Index", null, new { @class = "btn btn-default" })
</form>