@{
    ViewBag.Title = "Kiểm kê 2 sản phẩm";
    var errors = ViewBag.Errors as List<string>;
}

<h2>Kiểm kê đồng thời hai sản phẩm</h2>

@if (errors != null)
{
    <div class="alert alert-danger">
        <ul>@foreach (var e in errors)
        {<li>@e</li>}</ul>
    </div>
}
@if (ViewBag.Result != null)
{
    <div class="alert alert-info">@ViewBag.Result</div>
}

<form method="post" action="@Url.Action("Stocktake2", "Products")" style="max-width:500px">
    <div class="form-group">
        <label>Sản phẩm A</label>
        @Html.DropDownList("idA", (SelectList)ViewBag.ListA, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Số lượng thực tế của A</label>
        <input type="text" name="qtyA" class="form-control" value="@ViewBag.QtyA" />
    </div>
    <div class="form-group">
        <label>Sản phẩm B</label>
        @Html.DropDownList("idB", (SelectList)ViewBag.ListB, new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Số lượng thực tế của B</label>
        <input type="text" name="qtyB" class="form-control" value="@ViewBag.QtyB" />
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật cả hai</button>
    @Html.ActionLink("Xem danh sách", "Index", null, new { @class = "btn btn-default" })
</form>