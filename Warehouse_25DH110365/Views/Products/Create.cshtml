@{
    ViewBag.Title = "Thêm sản phẩm";
    var errors = ViewBag.Errors as List<string>;
}

<h2>Thêm sản phẩm</h2>
@if (errors != null)
{
    <div class="alert alert-danger">
        <ul>@foreach (var e in errors)
        {<li>@e</li>}</ul>
    </div>
}

<form method="post" action="@Url.Action("Create", "Products")" style="max-width:500px">
    <div class="form-group">
        <label>Tên sản phẩm</label>
        <input type="text" name="ProductName" class="form-control" value="@ViewBag.InName" />
    </div>
    <div class="form-group">
        <label>Danh mục</label>
        <input type="text" name="Category" class="form-control" value="@ViewBag.InCat" />
    </div>
    <div class="form-group">
        <label>Đơn giá</label>
        <input type="text" name="Price" class="form-control" value="@ViewBag.InPrice" />
    </div>
    <div class="form-group">
        <label>Số lượng</label>
        <input type="text" name="Quantity" class="form-control" value="@ViewBag.InQty" />
    </div>
    <button type="submit" class="btn btn-primary">Thêm</button>
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
</form>